{
	"name": "epb-ecaas-pcdb-sync",
	"private": "true",
	"type": "module",
	"scripts": {
		"init": "aws dynamodb create-table --cli-input-json file://schema.json --endpoint-url http://localhost:8000",
		"delete": "aws dynamodb delete-table --table-name products --endpoint-url http://localhost:8000",
		"dev": "NODE_ENV=development tsx ./src/import_local.ts",
		"build": "tsc",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1002.0",
		"@aws-sdk/client-s3": "^3.1002.0",
		"@aws-sdk/lib-dynamodb": "^3.1002.0",
		"tsx": "^4.21.0",
		"typescript": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.62.0"
	},
	"engines": {
		"node": "^22.17.1"
	}
}
